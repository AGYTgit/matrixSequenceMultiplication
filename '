#include <stdio.h>
#include <stdlib.h>

int parseInt(const char* str) {
    char* endptr;
    return strtol(str, &endptr, 10);
}

int* parseIntArr(const char* str, const int strLen, const int* output, const int outLen) {
    char* endptr;
    for (int i = 0; i < outLen; i++) {
        output[i] = strtol(str, &endptr, 10);
    }
}

int main(int argc, char* argv[]) {
    if (argc <= 1) {
        printf("No datafile providel\n");
        return 1;
    }

    char* filename = argv[1];

    printf("%d\n", argc);
    printf("%s\n", filename);
}
